<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="get" noun="EntityData">
        <description>
            This service used when we have to fetch filtered data by date from entity.
            This is a common service to fetch data from entity on the basis of given params.
        </description>
        <in-parameters>
            <parameter name="selectedEntity" required="true">
                <description>
                    Entity name from which data will be fetch. Example-
                    selectedEntity=org.apache.ofbiz.product.store.ProductStoreSetting
                </description>
            </parameter>
            <parameter name="filterByDate" type="Boolean" default-value="false"/>
            <parameter name="customParametersMap" type="Map">
                <description>
                    This map defines custom conditions to fetch data from given entity.Refer EntityFindData request for more details.
                </description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="entityValueList" type="List"/>
        </out-parameters>
        <actions>
            <if condition="filterByDate">
                <entity-find entity-name="${selectedEntity}" list="entityValueList">
                    <search-form-inputs input-fields-map="customParametersMap"/>
                    <date-filter/>
                </entity-find>
            <else>
                <entity-find entity-name="${selectedEntity}" list="entityValueList">
                    <search-form-inputs input-fields-map="customParametersMap"/>
                </entity-find>
            </else>
            </if>
        </actions>
    </service>

    <service verb="get" noun="DataDocumentView">
        <description>
            Service to fetch data from the Data Document View from existing DataDocument.
            Example payload:
            {
            "dataDocumentId": "TEST",
            "pageIndex": 0,
            "pageSize": 20,
            "customParametersMap": {"orderByField":"-^orderId"},
            "filterByDate": false
            }
        </description>
        <in-parameters>
            <parameter name="dataDocumentId" required="true"/>
            <parameter name="pageIndex" type="Integer" default-value="0"/>
            <parameter name="pageSize" type="Integer" default-value="20"/>
            <parameter name="customParametersMap" type="Map" default="[:]"/>
            <parameter name="filterByDate" type="Boolean" default-value="false"/>
            <parameter name="fieldsToSelect"/>
            <parameter name="distinct" type="Boolean" default-value="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="entityValueList" type="List"/>
        </out-parameters>
        <actions>
            <set field="entityName" from="'DataDocument.' + dataDocumentId"/>
            <if condition="filterByDate">
                <if condition="distinct">
                    <entity-find entity-name="${entityName}" list="entityValueList" distinct="true" cache="false">
                        <search-form-inputs input-fields-map="context + customParametersMap"/>
                        <date-filter/>
                        <select-field field-name="${fieldsToSelect}"/>
                    </entity-find>
                    <else>
                        <entity-find entity-name="${entityName}" list="entityValueList" cache="false">
                            <search-form-inputs input-fields-map="context + customParametersMap"/>
                            <date-filter/>
                            <select-field field-name="${fieldsToSelect}"/>
                        </entity-find>
                    </else>
                </if>
            <else>
                <if condition="distinct">
                    <entity-find entity-name="${entityName}" list="entityValueList" distinct="true" cache="false">
                        <search-form-inputs input-fields-map="context + customParametersMap"/>
                        <select-field field-name="${fieldsToSelect}"/>
                    </entity-find>
                    <else>
                        <entity-find entity-name="${entityName}" list="entityValueList" cache="false">
                            <search-form-inputs input-fields-map="context + customParametersMap"/>
                            <select-field field-name="${fieldsToSelect}"/>
                        </entity-find>
                    </else>
                </if>
            </else>
            </if>
        </actions>
    </service>

    <service verb="get" noun="ProductFacility">
        <in-parameters>
            <parameter name="facilityId" type="string" required="true"/>
            <parameter name="productId" type="string"/>
            <parameter name="pageSize" type="Integer" default-value="20"/>
            <parameter name="pageIndex" type="Integer" default-value="0"/>
            <parameter name="fieldsToSelect"/>
        </in-parameters>
        <out-parameters>
            <parameter name="productFacilities" type="List"/>
            <parameter name="count" type="Integer"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="org.apache.ofbiz.product.facility.ProductFacility" limit="pageSize" offset="pageIndex" list="productFacilities" distinct="true">
                <search-form-inputs />
            </entity-find>
        </actions>
    </service>

    <service verb="search" noun="ProductFacility">
        <description>
            Search products for a given facility using Solr and enrich the results with ProductFacility data.
            Supports keyword search and pagination.
        </description>
        <in-parameters>
            <parameter name="facilityId" required="true"/>
            <parameter name="keyword"/>
            <parameter name="pageIndex" type="Integer" default-value="0"/>
            <parameter name="pageSize" type="Integer" default-value="20"/>
        </in-parameters>
        <out-parameters>
            <parameter name="products" type="List"/>
            <parameter name="totalCount" type="Integer"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="products" from="[]"/>
            <set field="totalCount" from="0"/>

            <!-- Solr is the primary source in both cases.
                 Without keyword: query all products, then filter to only those with a ProductFacility record.
                 With keyword: query by keyword, return all results enriched with ProductFacility where it exists. -->
            <set field="filterConditions" from="['docType:PRODUCT']"/>
            <set field="solrQuery" value="*:*"/>
            <if condition="keyword">
                <set field="solrQuery" value="(productId:*${keyword}* OR productName:*${keyword}* OR internalName:*${keyword}* OR sku_s:*${keyword}*)"/>
            </if>

            <set field="solrStart" from="(pageIndex ?: 0) * (pageSize ?: 20)" type="Integer"/>
            <set field="params" from="[rows: (pageSize ?: 20), start: solrStart]"/>
            <set field="queryObject" from="[query: solrQuery, filter: filterConditions, params: params]"/>

            <service-call name="co.hotwax.search.SearchServices.run#SolrQuery"
                          in-map="[json: queryObject]"
                          out-map="solrResult"/>

            <if condition="solrResult &amp;&amp; solrResult.response">
                <set field="solrDocs" from="solrResult.response.docs ?: []"/>

                <script>productIds = solrDocs.collect { it.productId }.findAll { it }</script>

                <entity-find entity-name="org.apache.ofbiz.product.facility.ProductFacility" list="productFacilityList">
                    <econdition field-name="facilityId" from="facilityId"/>
                    <econdition field-name="productId" operator="in" from="productIds"/>
                </entity-find>

                <script>
                    productFacilityMap = productFacilityList.collectEntries { [(it.productId): it] }

                    if (keyword) {
                        // With keyword: return all Solr docs, enrich with ProductFacility where it exists
                        products = solrDocs.collect { doc ->
                            Map enriched = new HashMap(doc)
                            def pf = productFacilityMap[doc.productId]
                            if (pf) {
                                enriched.minimumStock       = pf.minimumStock
                                enriched.reorderQuantity    = pf.reorderQuantity
                                enriched.daysToShip         = pf.daysToShip
                                enriched.lastInventoryCount = pf.lastInventoryCount
                            }
                            enriched
                        }
                        totalCount = solrResult.response.numFound ?: 0
                    } else {
                        // No keyword: return only docs that have a ProductFacility record
                        products = solrDocs.findAll { doc -> productFacilityMap.containsKey(doc.productId) }.collect { doc ->
                            Map enriched = new HashMap(doc)
                            def pf = productFacilityMap[doc.productId]
                            enriched.minimumStock       = pf.minimumStock
                            enriched.reorderQuantity    = pf.reorderQuantity
                            enriched.daysToShip         = pf.daysToShip
                            enriched.lastInventoryCount = pf.lastInventoryCount
                            enriched
                        }
                        totalCount = products.size()
                    }
                </script>
            </if>
        </actions>
    </service>
</services>
